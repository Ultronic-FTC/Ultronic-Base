<Robot type="FirstInspires-FTC">
    <!-- Config for main 2026 Robot -->
    <EthernetDevice serialNumber="EthernetOverUsb:eth0:172.29.0.26" name="limelight" port="-1" ipAddress="172.29.0.1" />
    <LynxUsbDevice name="Control Hub Portal" serialNumber="(embedded)" parentModuleAddress="173">

        <LynxModule name="Control Hub" port="173">

            <Motor name="intake" port="0"/>-->
            <Motor name="BL" port="1"/>-->
            <Motor name="shooter" port="2"/>-->
            <Motor name="shooter2" port="3"/>-->


            <digitalDevices>
                <DigitalDevice port="1" name="transferBB"/>
                <DigitalDevice port="3" name="secondBB"/>
                <DigitalDevice port="5" name="thirdBB"/>
            </digitalDevices>

            <goBILDAPinpoint name="pinpoint" port="1" bus="1"/>
        </LynxModule>
        <LynxModule name="Expansion Hub 1" port="1">
            <Motor name="BR" port="0"/>
            <Motor name="FR" port="1"/>
            <Motor name="transfer" port="2"/>
            <Motor name="FL" port="3"/>

        </LynxModule>

        <ServoHub name="Servo Hub 3" port="3">
            <ServoFullRange name="light" port="0" />
            <ServoFullRange name="leftTurret" port="3" />
            <ServoFullRange name="leftTurret2" port="2" />
            <ServoFullRange name="latch" port="4" />
            <ServoFullRange name="adjhood" port="5" />
        </ServoHub>


        <ServoHub name="Servo Hub 4" port="4">
            <ServoFullRange name="rightTurret" port="3" />
            <ServoFullRange name="rightTurret2" port="4" />
        </ServoHub>
    </LynxUsbDevice>

<!--    <EthernetDevice name="limelight" serialNumber = "EthernetOverUsb:eth0:172.29.0.25" port = "0" ipAddress = "172.29.0.1"></EthernetDevice>-->
</Robot>